hostname: app-srv1
prefer_fqdn_over_hostname: true
manage_etc_hosts: true

users:
  - name: mihai
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM4AaxouynKJqYufoNqj7l0K+bJFcFNWWZALpTtRnkKA mihai_ssh-ed25519_mihai@preda.ca_a3bb1ab711c9de4cca91b3664f79a2f0"
  - name: vagrant
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM4AaxouynKJqYufoNqj7l0K+bJFcFNWWZALpTtRnkKA mihai_ssh-ed25519_mihai@preda.ca_a3bb1ab711c9de4cca91b3664f79a2f0"

package_update: true

# Bootstrap the OpenVox agent and submit a CSR to puppet.preda.ca.
# Manual signing on the puppetserver, then a second agent run, applies role::app1.
runcmd:
  - rpm -Uvh https://yum.voxpupuli.org/openvox8-release-el-9.noarch.rpm
  - dnf -y install openvox-agent
  - /opt/puppetlabs/bin/puppet config set server puppet.preda.ca --section main
  - /opt/puppetlabs/bin/puppet config set certname app-srv1.preda.ca --section main
  - /opt/puppetlabs/bin/puppet config set environment production --section main
  - /opt/puppetlabs/bin/puppet agent -t --waitforcert 0 || true
